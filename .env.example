# ============================================
# SAVVR - Configuración de APIs de Tiendas
# ============================================
# Copia este archivo a .env y completa los valores
# cp .env.example .env

# --- eBay API (gratis) ---
# Regístrate en: https://developer.ebay.com/
# Ve a "Keys" -> "Create a key set" para obtener Client ID y Client Secret
EBAY_CLIENT_ID=tu_client_id_aqui
EBAY_CLIENT_SECRET=tu_client_secret_aqui

# --- Etsy API (gratis) ---
# Regístrate en: https://developers.etsy.com/
# Ve a "Create App" para obtener tu API Key
ETSY_API_KEY=tu_api_key_aqui
ETSY_API_SECRET=tu_api_secret_aqui

